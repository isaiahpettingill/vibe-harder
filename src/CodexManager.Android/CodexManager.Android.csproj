<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.isaiahpettingill.vibeharder</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion><ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- Phone builds contain one runtime. Pass -r android-x64 for Intel devices/emulators. -->
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifiers>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.2" />
    <ProjectReference Include="../CodexManager.Mobile.UI/CodexManager.Mobile.UI.csproj" />
    <TrimmerRootDescriptor Include="../CodexManager/TrimmerRoots.xml" />
    <AndroidResource Include="../CodexManager/Assets/app.png" Link="Resources/drawable/app.png" />
  </ItemGroup>
</Project>
