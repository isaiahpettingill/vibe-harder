<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <!-- Avalonia's native graphics libraries match the .NET 10 WASM toolchain. -->
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>false</WasmEnableThreads>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexManager.Browser.UI/CodexManager.Browser.UI.csproj" />
    <PackageReference Include="Avalonia.Browser" Version="12.1.2" />
    <TrimmerRootDescriptor Include="../CodexManager/TrimmerRoots.xml" />
  </ItemGroup>
</Project>
