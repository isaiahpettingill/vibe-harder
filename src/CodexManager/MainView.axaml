<UserControl xmlns="https://github.com/avaloniaui" xmlns:local="using:CodexManager" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia" xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit" x:Class="CodexManager.MainView" Background="{DynamicResource AppBackground}" FontFamily="{DynamicResource UIFont}" FontSize="{DynamicResource UIFontSize}">
  <Grid Name="RootPanes" ColumnDefinitions="250,5,*" RowDefinitions="Auto,*,28">
    <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto" Margin="6,2">
      <local:IconButton Name="SidebarToggle" Icon="menu" Label="Toggle sidebar" HorizontalAlignment="Left" MinHeight="40"/>
      <local:IconButton Name="RemoteDownloadsButton" Grid.Column="1" Icon="download" Label="Pending downloads" MinHeight="40" IsVisible="False"/>
      <local:IconButton Name="MobileTerminalButton" Grid.Column="2" Icon="terminal" Label="Remote terminal" MinHeight="40" IsVisible="False" IsEnabled="False" Click="MobileTerminalClick"/>
    </Grid>
    <Border Name="SidebarDismiss" Grid.Row="1" Grid.ColumnSpan="3" ZIndex="19" Background="{DynamicResource AppBackground}" IsVisible="False"/>
    <Border Name="Sidebar" ZIndex="20" Background="{DynamicResource AppBackground}" Padding="10" Grid.Row="1">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Button Grid.Row="0" Name="OpenWorkspaceButton" Content="＋  Open workspace" HorizontalAlignment="Stretch" Click="WorkspaceSelectorClick"/>
        <TextBox Grid.Row="1" Name="SearchBox" Margin="0,8,0,0" PlaceholderText="Search all chats…" TextChanged="SearchChanged"/>
        <StackPanel Grid.Row="2">
          <Grid ColumnDefinitions="*,Auto" Margin="0,6"><Button Name="ArchiveViewButton" Content="Chats ▾" Click="ToggleArchiveView" Padding="6"/><Button Grid.Column="1" Name="ImportChatsButton" Content="Import" Click="ImportChatsClick" ToolTip.Tip="Import previous chats for the selected workspace"/></Grid>
          <Grid Name="ArchiveSelectionBar" ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="False" Margin="0,0,0,6">
            <TextBlock Name="ArchiveSelectionCount" Text="Select chats" VerticalAlignment="Center" FontSize="11"/>
            <local:IconButton Name="RestoreSelectedChats" Grid.Column="1" Icon="archive" Label="Unarchive selected chats" Click="RestoreSelectedChatsClick"/>
            <local:IconButton Name="DeleteSelectedChats" Grid.Column="2" Icon="delete" Label="Delete selected chats" Click="DeleteSelectedChatsClick"/>
            <local:IconButton Name="ClearArchiveSelection" Grid.Column="3" Icon="remove" Label="Clear selection" Click="ClearArchiveSelectionClick"/>
          </Grid>
        </StackPanel>
        <ScrollViewer Name="WorkspaceScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False"><StackPanel Name="WorkspaceTree" Spacing="8"/></ScrollViewer>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,6,0,0"><local:IconButton Name="SettingsButton" Icon="settings" Label="Settings" Click="SettingsClick" HorizontalAlignment="Left"/><local:IconButton Name="CommandPaletteButton" Grid.Column="1" Icon="command" Label="Command palette (Ctrl+Shift+P)" Click="PaletteClick" Margin="4,0,0,0"/></Grid>
      </Grid>
    </Border>
    <GridSplitter Name="SidebarSplitter" Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource AppBorder}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
    <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto">
    <Grid Name="ChatPane" RowDefinitions="36,*,Auto,Auto">
      <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="10,0"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Name="WorkspaceHeading" Text="No workspace selected" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><local:IconButton Name="ToggleTerminalButton" Grid.Column="2" Icon="terminal" Label="Show terminal (Ctrl+`)" Click="ToggleTerminal" VerticalAlignment="Center"/></Grid></Border>
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="10,6,10,4"><Grid ColumnDefinitions="22,*"><Image Name="ChatProviderIcon" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Name="ChatHeading" Text="Select a chat" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid><StackPanel Grid.Column="1" Orientation="Horizontal"><local:IconButton Name="SearchChatButton" Icon="search" Label="Search in chat (Ctrl+F)" Click="SearchChatClick"/><local:IconButton Name="CopyChatButton" Icon="copy" Label="Copy whole chat" Click="CopyChatClick"/><local:IconButton Name="ForkChatButton" Icon="fork" Label="Fork chat" Click="ForkChatClick"/><local:IconButton Name="ReconnectChatButton" Icon="refresh" Label="Reconnect agent without resending messages" Click="ReconnectChatClick"/><local:IconButton Name="ResumeChatButton" Icon="send" Label="Resume interrupted chat" Click="ResumeChatClick" IsVisible="False"/></StackPanel><local:IconButton Grid.Column="2" Name="ArchiveChatButton" Icon="archive" Label="Archive chat" Click="ArchiveChatClick" Margin="8,0"/><local:IconButton Grid.Column="3" Name="DeleteChatButton" Icon="delete" Label="Delete chat" Click="DeleteChatClick"/></Grid>
        <Border Grid.Row="1" Name="LoginPanel" IsVisible="False" Margin="14,6" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource AppBorder}" CornerRadius="5">
          <StackPanel Spacing="8">
            <TextBlock Name="LoginHeading" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Name="LoginButton" Content="Log in to Codex" Click="LoginClick" Classes="accent"/><Button Name="CheckLoginButton" Content="Already signed in? Check again" Click="CheckLoginClick"/></StackPanel>
            <StackPanel Name="LoginLinkPanel" IsVisible="False" Spacing="6"><TextBox Name="LoginUrl" IsReadOnly="True"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open in browser" Click="OpenLoginLinkClick"/><local:IconButton Name="CopyLoginLinkButton" Label="Copy login link" Click="CopyLoginLinkClick"/></StackPanel></StackPanel>
            <ContentControl Name="LoginTerminalHost" IsVisible="False" Height="220"/>
            <Button Name="PasteLoginButton" Content="Paste into terminal" Click="PasteLoginClick" IsVisible="False" Focusable="False" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="14,0,14,10" RowDefinitions="Auto,*">
            <local:ChatSearchBar Name="ChatSearch" Grid.Row="0"/>

            <StackPanel Grid.Row="1" Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="10" Margin="16,32">
              <TextBlock Name="WelcomeHeading" Text="Open a folder to start" FontSize="16" TextWrapping="Wrap"/>
              <TextBlock Name="WelcomeHint" Text="Your chats and terminals stay with the project." TextWrapping="Wrap" Classes="muted"/>
              <Button Name="WelcomeOpenButton" Content="Open workspace" Click="OpenWorkspaceClick"/>
            </StackPanel>
            <ListBox Grid.Row="1" Name="MessageList" AutoScrollToSelectedItem="False" ItemContainerTheme="{StaticResource TranscriptItemTheme}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.AllowAutoHide="False">
              <ListBox.ItemsPanel><ItemsPanelTemplate><local:TranscriptPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="local:Message">
                <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="0,10,0,12">
                  <StackPanel Spacing="6"><local:MessageView Message="{Binding}"/><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:Attachment"><local:AttachmentPreview Attachment="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <local:IconButton Name="HistoryNavigation" Grid.Row="1" Icon="chevron-down" Label="Return to latest message" Click="LatestMessagesClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,8" IsVisible="False" ZIndex="5" Background="{DynamicResource AppSurface}"/>
        </Grid>
      </Grid>
      <ScrollViewer Grid.Row="2" Name="PermissionScroll" MaxHeight="280" IsVisible="False"><StackPanel Name="InlinePermissions"/></ScrollViewer>
      <Border Grid.Row="3" Name="ComposerBorder" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource AppSurface}" Margin="8,4,8,8" Padding="6">
        <StackPanel Spacing="6">
          <ListBox Name="SlashCommands" IsVisible="False" MaxHeight="180" FontSize="11" PointerReleased="SlashCommandClicked"/>
          <Expander Name="QueuePanel" IsVisible="False" IsExpanded="True" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="QueueItems"/></ScrollViewer></Expander>
          
          
          <ItemsControl Name="AttachmentList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:Attachment"><Border Margin="0,0,6,5" Padding="6" Background="{DynamicResource AppSurface}" CornerRadius="4"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><Image Source="{Binding Thumbnail}" IsVisible="{Binding IsImage}" Width="80" Height="60" Stretch="Uniform"/><TextBlock Text="{Binding Name}" MaxWidth="150" TextTrimming="CharacterEllipsis" FontSize="11"/></StackPanel><local:IconButton Grid.Column="1" Icon="remove" IconSize="10" Label="Remove attachment" Tag="{Binding}" Click="RemoveAttachment" VerticalAlignment="Top"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <local:ComposerEditor FontFamily="{DynamicResource ChatFont}" Name="Composer" FontSize="{DynamicResource ChatFontSize}" Foreground="{DynamicResource AppText}" PlaceholderText="Ask Codex… paste an image or drop a file" MinHeight="48" MaxHeight="190" Padding="8,6" Background="Transparent" BorderThickness="0" TextChanged="DraftChanged"/>
          <Grid ColumnDefinitions="*,Auto"><WrapPanel Name="ConfigOptionsPanel" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="2"><local:IconButton Icon="add" Label="Attach files" Click="AttachFiles"/><local:IconButton Name="SendButton" Icon="send" Label="Send" Classes="accent" Click="SendClick"/></StackPanel></Grid>
        </StackPanel>
      </Border>
      </Grid>
      <Grid Grid.Column="1" Name="TerminalDrawer" IsVisible="False" ColumnDefinitions="5,*" Width="380" MinWidth="220">
        <Border Background="{DynamicResource AppBorder}" PointerPressed="TerminalResizeStart" PointerMoved="TerminalResizeMove" PointerReleased="TerminalResizeEnd" Cursor="SizeWestEast"/>
        <TabControl Grid.Column="1" Name="TerminalTabs" Margin="4,0,4,4"><TabControl.Styles><Style Selector="TabItem"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="11"/></Style><Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter"><Setter Property="Margin" Value="0,0,28,2"/><Setter Property="MinHeight" Value="26"/></Style></TabControl.Styles></TabControl>
        <local:IconButton Name="NewTerminalButton" Grid.Column="1" Icon="add" Label="New terminal" Click="NewTerminalClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0"/>
        <StackPanel Name="TerminalEmptyState" Grid.Column="1" IsVisible="{Binding !ItemCount, ElementName=TerminalTabs}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="No terminal open" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" FontSize="12"/>
          <Button Content="New terminal" Click="NewTerminalClick" HorizontalAlignment="Center" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource AppSurface}" Padding="12,4"><Grid ColumnDefinitions="*,Auto"><TextBlock Name="StatusText" Text="Ready — open a workspace to begin" FontSize="11" Foreground="{DynamicResource AppMuted}"/></Grid></Border>
  </Grid>
</UserControl>
