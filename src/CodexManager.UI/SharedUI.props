<Project>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <AssemblyName>VibeHarder.UI</AssemblyName>
    <Title>Vibe Harder</Title>
    <DefineConstants Condition="'$(MobileClient)' == 'true'">$(DefineConstants);MOBILE_CLIENT</DefineConstants>
    <DefineConstants Condition="'$(BrowserClient)' == 'true'">$(DefineConstants);BROWSER_CLIENT</DefineConstants>
    <TargetFramework>net11.0</TargetFramework>
    <TargetFramework Condition="'$(BrowserClient)' == 'true'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <StripSymbols>true</StripSymbols>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="../CodexManager/TrimmerRoots.xml" />
    <AdditionalCompileInputs Include="../CodexManager/TrimmerRoots.xml" />
    <AvaloniaResource Include="../CodexManager/Assets/**/*" Exclude="../CodexManager/Assets/*.icns" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="../CodexManager/*.axaml" Link="%(Filename)%(Extension)" />
    <Compile Include="../CodexManager/*.cs" Exclude="../CodexManager/Program.cs;../CodexManager/HeadlessHost.cs" />
    <Compile Remove="../CodexManager/TerminalSession.cs" Condition="'$(MobileClient)' == 'true'" />
    <Compile Include="../CodexManager.Mobile.UI/RemoteOnlyTerminal.cs" Condition="'$(MobileClient)' == 'true'" />
    <Compile Remove="../CodexManager/Store.cs;../CodexManager/StoreWriter.cs" Condition="'$(BrowserClient)' == 'true'" />
    <Compile Include="../CodexManager.Browser.UI/BrowserStore.cs" Condition="'$(BrowserClient)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="IconPacks.Avalonia.Codicons" Version="2.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Porta.Pty" Version="2.2.2" Condition="'$(MobileClient)' != 'true'" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SvcSystems.UI.Terminal" Version="1.1.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" Condition="'$(BrowserClient)' != 'true'" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />
    <PackageReference Include="Markdown.Avalonia.SyntaxHigh" Version="12.0.0-a3" />
  </ItemGroup>
  <ItemGroup Condition="'$(MobileClient)' != 'true'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
</Project>
